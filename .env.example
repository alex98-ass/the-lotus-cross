# Copy this file to .env and fill in your values.
# DATABASE_URL is REQUIRED for deployment (Supabase PostgreSQL).
# SMTP is optional — without it, emails are only logged to data/emails.log.

# Supabase connection string (from Supabase Dashboard → Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOURPROJECT.supabase.co:5432/postgres

# Email (RECOMMENDED). For Resend: create an API key at resend.com, paste it below.
# Without it, emails are only logged to data/emails.log.
RESEND_API_KEY=
EMAIL_FROM=The Lotus Cross <onboarding@resend.dev>

# Email (alternative SMTP). For Gmail: enable 2-Step Verification, create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=***
SMTP_FROM=The Lotus Cross <you@gmail.com>
